# Strict-but-buildable Next.js + Turborepo profile (pnpm 10).
# Keep the default isolated/symlinked node_modules (node-linker=isolated) for
# correctness + disk savings. We do NOT use node-linker=hoisted / shamefully-hoist,
# which would recreate npm's flat tree and reintroduce phantom-dependency bugs.
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true

# Surgical hoisting ONLY for tooling that does its own (non-pnpm-aware) module
# resolution. eslint-config-next + @next/eslint-plugin-next and Sentry's CLI/webpack
# plugin expect a flat layout; everything else stays strict.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*@next*
public-hoist-pattern[]=@sentry/*
