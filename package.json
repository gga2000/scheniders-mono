{
  "name": "scheniders",
  "private": true,
  "scripts": {
    "clean:ports": "lsof -ti:3000,3001,3002 | xargs -I{} kill -9 {} 2>/dev/null; exit 0",
    "dev": "pnpm clean:ports && turbo dev",
    "dev:platform": "turbo dev --filter=@scheniders/platform",
    "dev:storefront": "turbo dev --filter=@scheniders/storefront",
    "dev:admin": "turbo dev --filter=@scheniders/admin",
    "build": "turbo build",
    "build:platform": "turbo build --filter=@scheniders/platform",
    "build:storefront": "turbo build --filter=@scheniders/storefront",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "vitest run",
    "test:e2e": "turbo test:e2e --filter=@scheniders/platform",
    "storybook": "turbo storybook --filter=@scheniders/platform",
    "generate-types": "turbo generate-types --filter=@scheniders/supabase",
    "prepare": "husky",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ],
    "overrides": {
      "basic-ftp@<6.2.1": "^6.2.6",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "ip-address@<10.3.1": "^10.3.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "tmp@<0.2.6": "^0.2.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    }
  }
}
