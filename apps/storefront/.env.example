NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Root domain for wildcard routing (e.g., scheniders.com)
NEXT_PUBLIC_ROOT_DOMAIN=scheniders.com

# Local dev: use shopname.localhost:3001 to test subdomains
NEXT_PUBLIC_DEV_ROOT_DOMAIN=localhost:3001

# Outbound provider hosts (PKG-00 6a). Leave unset in production: with
# VERCEL_ENV=production any value other than the real host is refused.
# Point them at the provider mock (packages/provider-mock) for e2e/drills:
# META_API_BASE_URL=http://localhost:4010
# TIKTOK_API_BASE_URL=http://localhost:4010

# Instant WhatsApp order confirmation (server-only, never NEXT_PUBLIC_).
# The storefront hands each new order id to QStash, which delivers it to the
# platform's POST /api/webhooks/storefront-order. Leave these UNSET locally:
# a local storefront with them set queues real confirmations against
# production.
# QSTASH_TOKEN=
# QSTASH_URL=https://qstash-us-east-1.upstash.io
# STOREFRONT_ORDER_WEBHOOK_URL=https://<platform production origin>/api/webhooks/storefront-order
