{
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "outputDirectory": ".next",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/hourly-jobs",
      "schedule": "40 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh apps/admin packages/shared packages/supabase/src packages/supabase/package.json packages/ui"
}
