    {
      "page_id": "about",
      "sections": [
        {
          "base": {
            "card_align": "center",
            "cta_href": "/products",
            "cta_label_i18n": {
              "ar": "منتجاتنا",
              "en": "Our products",
            },
            "headline_i18n": {
              "ar": "منو شنايدر؟",
              "en": "Who is Scheniders?",
            },
            "secondary_cta_kind": "whatsapp",
            "secondary_cta_label_i18n": {
              "ar": "اطلب عبر واتساب",
              "en": "Order on WhatsApp",
            },
            "secondary_cta_value": "",
            "sub_i18n": {
              "ar": "متجر عطور من بغداد، نختار عطورنا يدوياً من أفخم الدور العالمية ونجرّبها بأنفسنا قبل ما توصلكم. تيستر مجاني مع كل طلب، دفع عند الاستلام، وترجيع خلال أسبوع.",
              "en": "A perfume house from Baghdad. We hand-pick from the world's finest houses and wear-test every scent ourselves. Free tester with every order, cash on delivery, returns within a week.",
            },
          },
          "enabled": true,
          "id": "<id>",
          "type": "hero_card_float",
        },
        {
          "base": {
            "eyebrow_i18n": {
              "ar": "مميزات",
              "en": "Highlights",
            },
            "items": [
              {
                "body_i18n": {
                  "ar": "كل طلب يجيك وياه تيستر زجاجي مجاني تجرّبه بحضور المندوب. إذا ما عجبك، ترجّعه وتستلم فلوسك كاملة خلال أسبوع.",
                  "en": "Every order arrives with a free glass tester you try with the courier present. Not for you? Return it within a week for a full refund.",
                },
                "icon_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/1059c16f-4311-4ceb-9365-ed7d3563d8dd.svg",
                "title_i18n": {
                  "ar": "تجرّب قبل ما تدفع",
                  "en": "Try before you pay",
                },
              },
              {
                "body_i18n": {
                  "ar": "نسعّر عطورنا بأرقام نقتنع بيها احنا قبلكم — مستحيل نحط سعر على عطر ما مستعدين ندفعه بأنفسنا.",
                  "en": "We price at numbers we would pay ourselves — never a price we wouldn't pay for the same bottle.",
                },
                "icon_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/0eed8928-51d1-422b-89d0-edf7cb5c56e5.svg",
                "title_i18n": {
                  "ar": "سعر عادل، بدون مبالغة",
                  "en": "Fair prices, no markup games",
                },
              },
              {
                "body_i18n": {
                  "ar": "أغلب الطلبات توصل خلال 18 ساعة من تثبيت الطلب، والدفع عند الاستلام بعد ما تفحص الطلب.",
                  "en": "Most orders arrive within 18 hours of confirmation, cash on delivery after you inspect the order.",
                },
                "icon_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/a018156e-4fe5-4010-ba33-90322ea745e1.svg",
                "title_i18n": {
                  "ar": "توصيل سريع لكل المحافظات",
                  "en": "Fast delivery to every governorate",
                },
              },
            ],
            "title_i18n": {
              "ar": "ليش تشتري من شنايدر؟",
              "en": "Why buy from Scheniders?",
            },
          },
          "enabled": true,
          "id": "<id>",
          "type": "pillars_grid",
        },
        {
          "base": {
            "eyebrow_i18n": {
              "ar": "آراء كشايخنا",
              "en": "What our regulars say",
            },
            "items": [
              {
                "name_i18n": {
                  "ar": "نورين",
                  "en": "Noreen",
                },
                "quote_i18n": {
                  "ar": "هاي ثاني مرة اشتري منكم، نوعية العطر والكوالتي مال تغليف حرفيا مشايفها مثلها بحياتي",
                  "en": "Second time ordering — the perfume quality and packaging are unlike anything I've seen.",
                },
              },
              {
                "name_i18n": {
                  "ar": "وسام الدراجي",
                  "en": "Wissam Al-Darraji",
                },
                "quote_i18n": {
                  "ar": "مصداقيتكم شي المفروض تنحمدون عليه, العطر وصلني وجان مثل الوصف ولا ولله الوصف ظالمه. كمت اخاف اطلب من النت من ورة الغش بس انتو عملة نادرة كلش شكراً",
                  "en": "Your honesty deserves praise — the perfume arrived exactly as described. I was wary of ordering online, but you are a rare find. Thank you.",
                },
              },
              {
                "name_i18n": {
                  "ar": "محمد علي",
                  "en": "Mohammed Ali",
                },
                "quote_i18n": {
                  "ar": "عطوركم وتغليفكم يفوزون صراحة",
                  "en": "Your perfumes and packaging honestly win.",
                },
              },
            ],
            "side_image_left_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/d8f80617-73ac-4b2f-bc58-014da751de42.svg",
            "side_image_right_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/08f20a22-335e-450a-86dd-4ee24a86204e.svg",
            "title_i18n": {
              "ar": "ليش الناس تموت على عطورنا",
              "en": "Why people are crazy about our perfumes",
            },
          },
          "enabled": true,
          "id": "<id>",
          "type": "testimonial_cards",
        },
        {
          "base": {
            "contact": {
              "cta_label_i18n": {
                "ar": "تواصل معنا",
                "en": "Contact us",
              },
              "icon_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/66a2314b-371e-4474-ad0d-53a4cad055f9.svg",
              "sub_i18n": {
                "ar": "إذا مازلت تريد معلومات إضافية، يمكنك دائما الاتصال بنا.",
                "en": "If you still need more information, you can always reach us.",
              },
              "title_i18n": {
                "ar": "لديك أسئلة أخرى؟",
                "en": "More questions?",
              },
              "whatsapp_number": "",
            },
            "eyebrow_i18n": {
              "ar": "أسئلة و أجوبة",
              "en": "Questions & answers",
            },
            "items": [
              {
                "a_i18n": {
                  "ar": "نحن قادرون فقط على إلغاء الطلبات في غضون الـ 12 ساعة الأولى بعد تقديم الطلب. وبعد ذلك تمت معالجة الطلب على الأرجح والاستعداد للشحن. نحن نعتذر عن أي إزعاج قد يسببه هذا الأمر، لكننا نفخر بتقديم الخدمة السريعة وهذا يشمل إخراج طلباتك في أسرع وقت ممكن.",
                  "en": "Orders can only be cancelled within the first 12 hours — after that they are likely processed and being prepared for shipping. We apologise for any inconvenience; fast service means your order goes out as quickly as possible.",
                },
                "q_i18n": {
                  "ar": "كيف يمكنني إلغاء طلب؟",
                  "en": "How can I cancel an order?",
                },
              },
              {
                "a_i18n": {
                  "ar": "جميع الطلبات داخل العراق يتم توصيلها خلال اقل من 18 ساعة من تاريخ تثبيت الحجز.",
                  "en": "All orders inside Iraq are delivered within 18 hours of confirmation.",
                },
                "q_i18n": {
                  "ar": "كم تستغرق عملية الشحن من الوقت؟",
                  "en": "How long does shipping take?",
                },
              },
              {
                "a_i18n": {
                  "ar": "تتم معالجة الطلبات وشحنها عادة في نفس يوم تثبيت الطلب.",
                  "en": "Orders are usually processed and shipped the same day they are confirmed.",
                },
                "q_i18n": {
                  "ar": "متى سوف يشحن طلبي؟",
                  "en": "When will my order ship?",
                },
              },
            ],
            "row_icon_url": "https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets/store-templates/scheniders/73c12b05-fbb5-4cc7-9a75-f61094855221.svg",
            "sub_i18n": {
              "ar": "هنا تجد أجوبة عن الأسئلة الاكثر شيوعا، إذا مازلت تريد معلومات إضافية، يمكنك دائما الاتصال بنا.",
              "en": "Answers to the most common questions — and you can always reach us for more.",
            },
            "title_i18n": {
              "ar": "الأسئلة الأكثر شيوعا",
              "en": "Frequently asked questions",
            },
          },
          "enabled": true,
          "id": "<id>",
          "type": "faq_contact_split",
        },
      ],
