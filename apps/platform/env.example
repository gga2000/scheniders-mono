# Supabase Configuration
# Get these from your Supabase project settings:
# https://app.supabase.com/ → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LightFunnels Webhook Configuration
LIGHTFUNNELS_WEBHOOK_SECRET=your_secret_token_here
WEBHOOK_LOGGING_ENABLED=true

# Store-builder preview: canonical storefront origin the editor iframe trusts
# for postMessage (both directions). MUST be set in deployed environments.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3001

# Storefront orders: tenants that get the instant WhatsApp confirmation
# (comma-separated tenant uuids). Interakt is ONE global sender, so list only
# tenants whose customers expect messages from that number. Empty = nobody.
# The endpoint also needs QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY.
STOREFRONT_WA_CONFIRM_TENANT_IDS=

# Prime courier API (lib/prime). Scheniders' integrated-system account; Prime
# issues one host + login per environment. Test host: https://devtest.prime-iq.com/myp/webapi
# A tenant ships through the API only once it has a prime_connections row.
PRIME_API_BASE_URL=
PRIME_SYSTEM_CODE=
PRIME_PASSWORD=
PRIME_INITIAL_TOKEN=
