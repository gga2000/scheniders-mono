# Supabase Configuration
# Get these from your Supabase project settings:
# https://app.supabase.com/ → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LightFunnels Webhook Configuration
LIGHTFUNNELS_WEBHOOK_SECRET=your_secret_token_here
WEBHOOK_LOGGING_ENABLED=true

# Where stores live: <slug>.<this>. Defaults to usefermi.com (Fermi A4).
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=usefermi.com

# The dashboard's address and the old ones whose pages 308 to it (same path).
# Leave unset until the new address can sign people in: Supabase Auth URL
# configuration (Site URL + redirect URLs) and the Turnstile widget's
# hostnames must name it first. /api is never moved.
# DASHBOARD_HOST=app.usefermi.com
# DASHBOARD_OLD_HOSTS=schenidersapp.xyz

# Store-builder preview: canonical storefront origin the editor iframe trusts
# for postMessage (both directions). MUST be set in deployed environments.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3001

# Storefront orders: tenants that get the instant WhatsApp confirmation
# (comma-separated tenant uuids). Interakt is ONE global sender, so list only
# tenants whose customers expect messages from that number. Empty = nobody.
# The endpoint also needs QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY.
STOREFRONT_WA_CONFIRM_TENANT_IDS=

# Prime courier API (lib/prime). Scheniders' integrated-system account; Prime
# issues one host + login per environment. Test host: https://devtest.prime-iq.com/myp/webapi
# A tenant ships through the API only once it has a prime_connections row.
PRIME_API_BASE_URL=
PRIME_SYSTEM_CODE=
PRIME_PASSWORD=
PRIME_INITIAL_TOKEN=

# Qi Card payment gateway (wallet top-ups). Sandbox: https://uat-sandbox-3ds-api.qi.iq/api/v1
QI_API_BASE_URL=
QI_TERMINAL_ID=
QI_USERNAME=
QI_PASSWORD=
# Qi's public key (PEM) for its payment messages; \n escapes are allowed
QI_WEBHOOK_PUBLIC_KEY=
# Seals saved card tokens (AES-256-GCM): 32 random bytes in base64, e.g. `openssl rand -base64 32`.
# Without it shops can still pay by Qi card, but cannot save a card for auto refill.
# Never change it while cards are saved: they would stop opening and auto refill would stop.
QI_TOKEN_KEY=
