{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@scheniders/sections": ["../../packages/sections/src"],
      "@scheniders/sections/*": ["../../packages/sections/src/*"],
      "@scheniders/shared": ["../../packages/shared/src"],
      "@scheniders/shared/*": ["../../packages/shared/src/*"],
      "@scheniders/supabase": ["../../packages/supabase/src"],
      "@scheniders/ui": ["../../packages/ui/src"],
      "@scheniders/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "vitest.config.ts", "vitest.config.mts"]
}
