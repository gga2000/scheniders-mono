{
    "css.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "tailwindCSS.experimental.classRegex": [
        [
            "cva\\(([^)]*)\\)",
            "[\"'`]([^\"'`]*)[\"'`]"
        ],
        [
            "cx\\(([^)]*)\\)",
            "[\"'`]([^\"'`]*)[\"'`]"
        ],
        [
            "cn\\(([^)]*)\\)",
            "[\"'`]([^\"'`]*)[\"'`]"
        ]
    ],
    "tailwindCSS.files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/.next/**",
        "**/backup_page.tsx",
        "**/backup_*.tsx"
    ],
    "css.validate": false,
    "tailwindCSS.lint.recommendedVariantOrder": "ignore"
}