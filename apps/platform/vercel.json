{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "git": {
        "deploymentEnabled": {
            "main": true,
            "**": false
        }
    },
    "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh apps/platform packages/sections packages/shared packages/supabase/src packages/supabase/package.json packages/ui packages/provider-mock",
    "crons": [
        {
            "path": "/api/cron/backup",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/waseet-sync",
            "schedule": "0 12 * * *"
        },
        {
            "path": "/api/cron/trial-suspend",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/subscription-renew",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/cleanup-deleted-orders",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/abandoned-cart-recovery",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/cron/waseet-locations",
            "schedule": "0 3 * * 1"
        }
    ]
}
