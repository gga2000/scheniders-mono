exports[`faq_contact_split — frozen > LIVE_PDP_FAQ ar 1`] = `"<section class="px-4 py-bk-section"><div class="mb-bk-lg flex flex-col gap-bk-xs items-center text-center"><span class="inline-flex items-center gap-1.5 px-3 py-1 font-label text-xs font-bold leading-none" style="background-color:color-mix(in srgb, var(--bk-accent, #ffd84a) 16%, transparent);color:var(--bk-ink, #1a1a1a);border-radius:var(--bk-radius-pill, 9999px);font-family:var(--bk-font-body, inherit)" data-i18n-field="eyebrow_i18n"><svg viewBox="0 0 16 16" width="12" height="12" fill="var(--bk-accent, #ffd84a)" aria-hidden="true"><path d="M8 0l1.8 5.2L15 7l-5.2 1.8L8 14l-1.8-5.2L1 7l5.2-1.8z"></path></svg>أسئلة و أجوبة</span><h2 data-i18n-field="title_i18n" class="font-display font-black text-balance text-bk-h2" style="color:var(--bk-ink, #1a1a1a);font-family:var(--bk-font-display, inherit)">الأسئلة الأكثر شيوعا</h2><p data-i18n-field="sub_i18n" class="max-w-prose font-body text-base text-pretty mx-auto" style="color:var(--bk-ink-soft, rgb(26 26 26 / 0.7));font-family:var(--bk-font-body, inherit)">هنا تجد أجوبة عن الأسئلة الاكثر شيوعا، إدا مازلت تريد معلومات إضافية، يمكنك دائما الاتصال بنا.</p></div><div class="mx-auto grid max-w-5xl grid-cols-1 items-start gap-bk-md lg:grid-cols-5 lg:gap-bk-lg"><div class="space-y-bk-sm lg:col-span-3"><details name="faq-_R_0_" open="" class="group overflow-hidden" style="background-color:var(--bk-surface, #ffffff);border-radius:var(--bk-radius-card, 1rem);box-shadow:var(--bk-shadow-card, 0 16px 40px -20px rgb(26 26 26 / 0.18))"><summary class="flex w-full cursor-pointer list-none items-center gap-3 px-5 py-4 text-start transition-opacity duration-bk-fast motion-reduce:transition-none active:opacity-70 [&amp;::-webkit-details-marker]:hidden"><img alt="" loading="lazy" width="20" height="20" decoding="async" data-nimg="1" class="h-5 w-5 shrink-0 object-contain" style="color:transparent" src="https://sduvpgqwhxragxtxztur.supabase.co/storage/v1/object/public/tenant-assets