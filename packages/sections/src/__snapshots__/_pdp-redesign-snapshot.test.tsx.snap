-base text-bk-ink placeholder:text-bk-ink-faint transition-colors duration-bk-fast focus-visible:border-bk-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus aria-[invalid=true]:border-bk-danger motion-reduce:transition-none text-left pr-10" id="_R_0_-customer_name" name="name" value=""/></div></div></div></div></div><div data-stage="address" data-open="false" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="-mx-1 min-h-0 overflow-hidden" inert=""><div class="space-y-bk-sm px-1 pb-1 pt-bk-sm"><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0"><p class="flex items-center gap-1.5 font-bk-display text-[15px] font-black text-bk-ink"><span class="material-symbols-outlined text-lg text-bk-ink-soft" aria-hidden="true">local_shipping</span>Where should we deliver?</p></div><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0 text-left"><label for="_R_0_-governorate_code" class="mb-1 block font-bk-body text-[13px] font-bold text-bk-ink-soft">Governorate</label><div class="relative"><select name="governorate" required="" autoComplete="address-level1" class="h-[52px] w-full rounded-bk-input border-bk border-bk-divider bg-bk-surface px-4 font-bk-body text-base text-bk-ink placeholder:text-bk-ink-faint transition-colors duration-bk-fast focus-visible:border-bk-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus aria-[invalid=true]:border-bk-danger motion-reduce:transition-none appearance-none text-left pr-10" id="_R_0_-governorate_code"><option value="" disabled="" selected="">Choose governorate</option><option value="BG">Baghdad</option><option value="BA">Basra</option><option value="ER">Erbil</option><option value="SU">Sulaymaniyah</option><option value="DH">Duhok</option><option value="