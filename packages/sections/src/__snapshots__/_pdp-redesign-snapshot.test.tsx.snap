name" name="name" value=""/></div></div></div></div></div><div data-stage="address" data-open="false" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="-mx-1 min-h-0 overflow-hidden" inert=""><div class="space-y-bk-sm px-1 pb-1 pt-bk-sm"><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0"><p class="flex items-center gap-1.5 font-bk-display text-[15px] font-black text-bk-ink"><span class="material-symbols-outlined text-lg text-bk-ink-soft" aria-hidden="true">local_shipping</span>Where should we deliver?</p></div><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0 text-left"><label for="_R_0_-governorate_code" class="mb-1 block font-bk-body text-[13px] font-bold text-bk-ink-soft">Governorate</label><div class="relative"><select name="governorate" required="" autoComplete="address-level1" class="h-[52px] w-full rounded-bk-input border-bk border-bk-divider bg-bk-surface px-4 font-bk-body text-base text-bk-ink placeholder:text-bk-ink-faint transition-colors duration-bk-fast focus-visible:border-bk-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus aria-[invalid=true]:border-bk-danger motion-reduce:transition-none appearance-none text-left pr-10" id="_R_0_-governorate_code"><option value="" disabled="" selected="">Choose governorate</option><option value="BG">Baghdad</option><option value="BA">Basra</option><option value="ER">Erbil</option><option value="SU">Sulaymaniyah</option><option value="DH">Duhok</option><option value="NI">Ninawa</option><option value="KI">Kirkuk</option><option value="DI">Diyala</option><option value="AN">Anbar</option><option value="BB">Babil</option><option value="KE">Karbala</option><option value="NA">Najaf</option><option value="QA">Diwaniyah</option><option value="MU">Muthanna</option><option value="DQ">Dhi Qar</option><option value="WA">Wasit</option><option value="MA">Maysan</option><option value="SA">Saladin</option></select><span aria-hidden="true" class="pointer-events-none absolute top-1/2 -translate-y-1/2 text-bk-ink-faint right-3"><span class="material-symbols-outlined text-xl" aria-hidden="true">expand_more</span></span></div></div><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0 text-left"><label for="_R_0_-address_details" class="mb-1 block font-bk-body text-[13px] font-bold text-bk-ink-soft">Area and street</label><div class="relative"><input type="text" required="" dir="auto" autoComplete="street-address" enterKeyHint="next" placeholder="e.g. Mansour, 14th Ramadan street" class="h-[52px] w-full rounded-bk-input border-bk border-bk-divider bg-bk-surface px-4 font-bk-body text-base text-bk-ink placeholder:text-bk-ink-faint transition-colors duration-bk-fast focus-visible:border-bk-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus aria-[invalid=true]:border-bk-danger motion-reduce:transition-none text-left pr-10" id="_R_0_-address_details" name="address" value=""/></div></div></div></div></div><div data-stage="extras" data-open="false" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="-mx-1 min-h-0 overflow-hidden" inert=""><div class="space-y-bk-sm px-1 pb-1 pt-bk-sm"><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0 text-left"><label for="_R_0_-submit-error-landmark" class="mb-1 block font-bk-body text-[13px] font-bold text-bk-ink-soft">Nearest landmark <span class="font-normal text-bk-ink-faint">(optional)</span></label><input id="_R_0_-submit-error-landmark" type="text" dir="auto" autoComplete="off" enterKeyHint="done" placeholder="e.g. next to the Al-Rafidain bank" class="h-[52px] w-full rounded-bk-input border-bk border-bk-divider bg-bk-surface px-4 font-bk-body text-base text-bk-ink placeholder:text-bk-ink-faint transition-colors duration-bk-fast focus-visible:border-bk-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus aria-[invalid=true]:border-bk-danger motion-reduce:transition-none text-left" name="landmark" value=""/></div><div class="transition-[opacity,transform] duration-bk-base ease-out motion-reduce:transition-none translate-y-1 opacity-0"><button type="button" class="flex min-h-11 w-full items-center gap-1.5 font-bk-body text-sm font-bold text-bk-ink-soft"><span class="material-symbols-outlined text-lg" aria-hidden="true">add_circle</span>Add a backup number</button></div></div></div></div></div><div class="space-y-2" data-layer="qty" data-layer-label="Quantity and payment"><div class="flex flex-wrap items-center gap-2"><button type="button" aria-expanded="false" aria-controls="_R_0_-submit-error-qty-panel" class="group inline-flex h-11 items-center focus-visible:outline-none"><span class="inline-flex h-9 items-center gap-1.5 rounded-bk-pill border-bk px-3 font-bk-body text-[13px] transition-colors duration-bk-fast group-focus-visible:ring-2 group-focus-visible:ring-bk-focus group-active:bg-bk-surface-alt motion-reduce:transition-none border-bk-divider bg-bk-surface"><span class="text-bk-ink-soft">Quantity</span><span class="font-bold text-bk-ink"><bdi class="tabular-nums">1</bdi></span><span class="material-symbols-outlined text-base text-bk-ink-faint transition-transform duration-bk-fast motion-reduce:transition-none" aria-hidden="true">expand_more</span></span></button><span data-payment-statement="true" class="inline-flex h-11 items-center px-1 font-bk-body text-[13px] font-bold text-bk-ink">Payment: Cash on delivery</span></div><div class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="min-h-0 overflow-hidden" inert=""></div></div></div><div class="space-y-bk-sm"><div class="divide-y divide-dashed divide-bk-divider rounded-bk-card border-bk border-bk-divider px-4"><div><div class="flex items-center justify-between gap-3 py-2"><span class="flex min-w-0 items-baseline gap-1.5 font-bk-body text-[13px] text-bk-ink-soft"><span class="truncate">عطر ويفر انتنس الفاخر من باريس كورنر للرجال</span><bdi class="shrink-0 text-xs text-bk-ink-faint tabular-nums">× 1</bdi></span><span class="shrink-0 whitespace-nowrap tabular-nums font-bk-body text-[13px] font-bold text-bk-ink"><bdi>25,000 IQD</bdi></span></div><div class="flex items-center justify-between gap-3 py-2"><span class="flex min-w-0 items-baseline gap-1.5 font-bk-body text-[13px] text-bk-ink-soft"><span class="truncate">Delivery</span></span><span class="shrink-0 whitespace-nowrap tabular-nums font-bk-body text-[13px] font-bold text-bk-ink"><span data-delivery-fee="true"><span class="text-bk-ink">Free to every governorate</span></span></span></div></div><div class="flex items-center justify-between gap-3 py-3"><span class="flex min-w-0 items-baseline gap-1.5 font-bk-body text-[15px] font-black text-bk-ink"><span class="truncate">Total</span></span><span class="shrink-0 whitespace-nowrap tabular-nums font-bk-display text-[22px] font-black leading-none text-bk-ink"><bdi>25,000 IQD</bdi></span></div></div><div class="flex items-stretch gap-2" data-layer="submit" data-layer-label="Order buttons"><button type="submit" class="relative isolate flex min-h-[60px] flex-1 items-center justify-center gap-3 overflow-hidden rounded-bk-input bg-bk-primary px-5 text-bk-on-primary shadow-bk-button transition-[transform,background-color,box-shadow] duration-bk-fast motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus focus-visible:ring-offset-2 focus-visible:ring-offset-bk-surface disabled:cursor-not-allowed disabled:bg-bk-primary-disabled disabled:shadow-none hover:bg-bk-primary-hover active:scale-[0.97] active:bg-bk-primary-active active:shadow-none"><span aria-hidden="true" class="bk-xp-sheen pointer-events-none absolute inset-y-0 left-0 -z-10 w-2/5"></span><span class="font-bk-display text-[19px] font-black leading-tight">Place my order</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-bk-pill bg-bk-on-primary/15"><span class="material-symbols-outlined text-xl bk-xp-nudge" aria-hidden="true">arrow_forward</span></span></button></div><div data-promise-band="true"><ul aria-label="What you get with your order" class="divide-y divide-bk-on-secondary/15 rounded-bk-card bg-bk-secondary px-4 py-1 text-bk-on-secondary"><li data-promise-row="trust" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">verified_user</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug" data-i18n-field="reassurance_i18n">Open it and try it before you pay. Tester included.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80"><span data-i18n-field="return_promise_i18n">Don&#x27;t like it? Refuse it in front of the courier, or return it within a week.</span> <a href="#guarantee" class="relative inline-block font-bold text-bk-on-secondary underline underline-offset-2 before:absolute before:-inset-x-2 before:-inset-y-[14px] before:content-[&#x27;&#x27;] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus">Terms</a></p></div></li><li data-promise-row="delivery" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">local_shipping</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">Delivery is free.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80" data-i18n-field="delivery_sla_i18n">Most orders arrive within 24 hours of confirmation</p></div></li><li data-promise-row="call" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">call</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">You&#x27;ll get a call from <bdi class="whitespace-nowrap">0777 970 3832</bdi> to confirm your order. Answer it and your order ships.</p><a href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0D%0AVERSION%3A3.0%0D%0AN%3AScheniders%20%E2%80%94%20order%20confirmation%3B%3B%3B%3B%0D%0AFN%3AScheniders%20%E2%80%94%20order%20confirmation%0D%0ATEL%3BTYPE%3DCELL%2CVOICE%3A%2B9647779703832%0D%0AEND%3AVCARD" download="Scheniders — order confirmation.vcf" data-save-number="true" class="inline-flex min-h-11 items-center gap-1.5 rounded-bk-pill border-bk border-bk-on-secondary/40 px-3 font-bk-body text-[13px] font-bold text-bk-on-secondary transition-colors duration-bk-fast hover:bg-bk-on-secondary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus motion-reduce:transition-none"><span class="material-symbols-outlined text-base" aria-hidden="true">person_add</span>Save our number</a></div></li></ul><p aria-live="polite" data-save-hint="true" class="mt-bk-xs text-center font-bk-body text-[13px] font-bold text-bk-ink-soft sr-only"></p></div></div></form><section data-scent-card="" aria-labelledby="_R_27_" class="space-y-bk-sm rounded-bk-card bg-bk-surface-alt p-4"><div class="flex items-center justify-between gap-2"><h2 id="_R_27_" class="font-bk-body text-xs font-black text-bk-ink-soft">Scent profile</h2></div><div class="flex items-center justify-between gap-3 border-t border-bk-divider pt-1"><a href="#reviews-summary" data-scent-rating="link" class="inline-flex min-h-11 items-center gap-1.5 font-bk-body text-sm font-bold text-bk-ink-soft"><span role="img" aria-label="4.6 / 5" class="inline-flex items-center gap-0.5"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span><bdi class="font-black tabular-nums text-bk-ink">4.6</bdi><span aria-hidden="true">·</span><span>12 reviews</span></a><button type="button" aria-haspopup="dialog" aria-expanded="false" class="inline-flex min-h-11 items-center gap-1 font-bk-body text-sm font-black text-bk-ink"><span>The scent’s story</span><span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_right</span></button><dialog aria-labelledby="_R_ba7_" class="m-0 mt-auto max-h-[85dvh] w-full max-w-none overflow-y-auto overscroll-contain rounded-t-bk-card bg-bk-surface p-0 text-bk-ink backdrop:bg-bk-ink/60 motion-safe:animate-[bk-fade-up_var(--bk-duration-base)_ease-out_both]"><div class="px-4 pb-6 pt-3"><div class="flex items-center justify-between gap-3"><h2 id="_R_ba7_" class="font-bk-display text-base font-black text-left">The scent’s story</h2><button type="button" aria-label="Close" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-bk-pill focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></div><div class="mt-3"><div data-scent-story="" class="space-y-bk-sm"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-ink [unicode-bidi:plaintext] text-left">عطر خشبي دافئ.
يدوم طول اليوم.</p><ul aria-label="Scent notes" class="space-y-bk-sm"><li class="flex items-start gap-3"><div class="min-w-0 text-left"><p class="font-bk-body text-sm font-bold text-bk-ink">ثبات</p><p class="font-bk-body text-xs leading-relaxed text-bk-ink-soft">يدوم طول اليوم</p></div></li><li class="flex items-start gap-3"><img alt="" loading="lazy" width="56" height="56" decoding="async" data-nimg="1" class="h-14 w-14 shrink-0 rounded-bk-input object-cover" style="color:transparent" src="https://cdn.example.com/fixture/note.jpg"/><div class="min-w-0 text-left"><p class="font-bk-body text-sm font-bold text-bk-ink">فوحان</p><p class="font-bk-body text-xs leading-relaxed text-bk-ink-soft">ينتشر بهدوء</p></div></li></ul></div></div></div></dialog></div></section></div></section>"
`;

exports[`pdp_direct_order express — redesign draft > en, scent attributes 1`] = `
"<link rel="preload" as="image" href="https://cdn.example.com/fixture/cover.jpg" fetchPriority="high"/><style data-precedence="bk-sections" data-href="bk-pdp-express-motion">
@keyframes bk-xp-sweep {
  0%, 62% { transform: translateX(-160%) skewX(-18deg); }
  100% { transform: translateX(360%) skewX(-18deg); }
}
@keyframes bk-xp-nudge {
  0%, 70%, 86%, 100% { transform: none; }
  78%, 93% { transform: translateX(var(--bk-xp-nudge)); }
}
@keyframes bk-xp-drop {
  0%, 100% { transform: none; opacity: 0.75; }
  50% { transform: translateY(var(--bk-xp-drop)); opacity: 1; }
}
.bk-xp-sheen {
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bk-primary), var(--bk-surface)), transparent);
  mix-blend-mode: screen;
  transform: translateX(-160%) skewX(-18deg);
}
.bk-xp-nudge { --bk-xp-nudge: 0.25rem; }
.bk-xp-nudge-rtl { --bk-xp-nudge: -0.25rem; }
.bk-xp-drop { --bk-xp-drop: 0.2rem; }
@media (prefers-reduced-motion: no-preference) {
  .bk-xp-sheen {
    animation: bk-xp-sweep calc(var(--bk-duration-reveal) * 6) ease-in-out
      calc(var(--bk-duration-reveal) * 2) infinite both;
  }
  .bk-xp-sheen-rtl { animation-direction: reverse; }
  .bk-xp-nudge, .bk-xp-nudge-rtl {
    animation: bk-xp-nudge calc(var(--bk-duration-reveal) * 6) ease-in-out
      calc(var(--bk-duration-reveal) * 2) infinite;
  }
  .bk-xp-drop {
    animation: bk-xp-drop calc(var(--bk-duration-reveal) * 2) ease-in-out infinite;
  }
}
