20px, calc((100cqi - 3.75rem - 2.25rem) / 3.30), 36px)">25,000</span><span class="text-[14px] font-bold">IQD</span></bdi><span class="font-bk-body text-xs font-bold leading-tight text-bk-ink-soft text-balance text-left" style="min-width:3.75rem" data-i18n-field="price_label_i18n">After discount</span></div><span class="sr-only">Price 25,000 IQD, struck price 32,000 IQD</span></div><span class="relative flex shrink-0 flex-col items-center justify-center rounded-bk-pill bg-bk-secondary text-bk-on-secondary shadow-bk-card motion-safe:animate-[bk-seal-in_var(--bk-duration-reveal)_cubic-bezier(.2,.9,.3,1.3)_both]" style="width:clamp(56px, 17vw, 68px);height:clamp(56px, 17vw, 68px)"><span aria-hidden="true" class="absolute inset-[4px] rounded-bk-pill border-bk border-dashed border-bk-primary/60"></span><span class="font-bk-display text-[21px] font-black leading-none tabular-nums"><bdi>22%</bdi></span><span class="mt-0.5 font-bk-body text-[11px] font-bold leading-none text-bk-on-secondary">OFF</span></span></div></div><div role="timer" aria-live="off" aria-label="Discount offer ends in:" class="relative overflow-hidden rounded-bk-input bg-bk-secondary text-bk-on-secondary"><div class="flex h-[38px] items-center justify-between gap-3 px-3 "><span class="flex items-center gap-1.5 font-bk-body text-[13px] font-bold " data-i18n-field="offer_clock.label_i18n"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-bk-pill bg-bk-on-secondary/60 motion-safe:animate-pulse"></span>Discount offer ends in:</span><span aria-hidden="true" class="flex items-baseline font-bk-display text-[17px] font-black tabular-nums text-bk-on-secondary"><span>--</span><span class="px-0.5 opacity-60">:</span><span>--</span><span class="px-0.5 opacity-60">:</span><span class="inline-block motion-safe:animate-[bk-tick_var(--bk-duration-base)_ease-out]">--</span></span></div></div></div><form id="direct-order" noValidate="" class="scroll-mt-24 space-y-bk-md pt-bk-xs"><div data-layer="form" data-layer