box-shadow] duration-bk-fast motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus focus-visible:ring-offset-2 focus-visible:ring-offset-bk-surface disabled:cursor-not-allowed disabled:bg-bk-primary-disabled disabled:shadow-none hover:bg-bk-primary-hover active:scale-[0.97] active:bg-bk-primary-active active:shadow-none"><span aria-hidden="true" class="bk-xp-sheen pointer-events-none absolute inset-y-0 left-0 -z-10 w-2/5"></span><span class="font-bk-display text-[19px] font-black leading-tight">Place my order</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-bk-pill bg-bk-on-primary/15"><span class="material-symbols-outlined text-xl bk-xp-nudge" aria-hidden="true">arrow_forward</span></span></button></div><div data-promise-band="true"><ul aria-label="What you get with your order" class="divide-y divide-bk-on-secondary/15 rounded-bk-card bg-bk-secondary px-4 py-1 text-bk-on-secondary"><li data-promise-row="trust" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">verified_user</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug" data-i18n-field="reassurance_i18n">Open it and try it before you pay. Tester included.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80"><span data-i18n-field="return_promise_i18n">Don&#x27;t like it? Refuse it in front of the courier, or return it within a week.</span></p></div></li><li data-promise-row="delivery" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">local_shipping</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">Delivery is free.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80" data-i18n-field="delivery_sla_i18n">Most orders arrive within 24 hours of confirmation</p></div></li><li data-promise-row="call" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">call</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">You&#x27;ll get a call from <bdi class="whitespace-nowrap">0777 970 3832</bdi> to confirm your order. Answer it and your order ships.</p><a href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0D%0AVERSION%3A3.0%0D%0AN%3AScheniders%20%E2%80%94%20order%20confirmation%3B%3B%3B%3B%0D%0AFN%3AScheniders%20%E2%80%94%20order%20confirmation%0D%0ATEL%3BTYPE%3DCELL%2CVOICE%3A%2B9647779703832%0D%0AEND%3AVCARD" download="Scheniders — order confirmation.vcf" data-save-number="true" class="inline-flex min-h-11 items-center gap-1.5 rounded-bk-pill border-bk border-bk-on-secondary/40 px-3 font-bk-body text-[13px] font-bold text-bk-on-secondary transition-colors duration-bk-fast hover:bg-bk-on-secondary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus motion-reduce:transition-none"><span class="material-symbols-outlined text-base" aria-hidden="true">person_add</span>Save our number</a></div></li></ul><p aria-live="polite" data-save-hint="true" class="mt-bk-xs text-center font-bk-body text-[13px] font-bold text-bk-ink-soft sr-only"></p></div></div></form><section class="border-t border-bk-divider pt-bk-md"><div class="mb-bk-md flex flex-col gap-bk-2xs items-start text-left"><h2 class="font-bk-display text-bk-chapter font-black text-bk-ink text-balance">About the scent</h2></div><p id="_R_27_" dir="auto" class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-ink-soft line-clamp-5 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]">عطر خشبي دافئ.
يدوم طول اليوم.</p><button type="button" aria-expanded="false" aria-controls="_R_27_" class="mt-1 flex min-h-11 w-full items-center justify-start gap-1 font-bk-body text-sm font-bold text-bk-ink">Read more<span class="material-symbols-outlined text-lg" aria-hidden="true">expand_more</span></button></section><section data-layer="scent-journey" aria-labelledby="_R_2n_" class="border-t border-bk-divider pt-bk-md"><div class="mb-bk-md flex flex-col gap-bk-2xs items-start text-left"><h2 id="_R_2n_" data-i18n-field="scent_journey.title_i18n" class="font-bk-display text-bk-chapter font-black text-bk-ink text-balance">The scent journey</h2></div><div class="space-y-bk-sm rounded-bk-card border-bk border-bk-divider bg-bk-surface-alt p-4"><ol><li data-stage="top" class="flex gap-3"><span aria-hidden="true" class="relative flex w-3 shrink-0 justify-center"><span class="mt-1 h-3 w-3 rounded-bk-pill border-bk-bold border-bk-ink bg-bk-surface"></span><span class="absolute bottom-0 top-5 w-px bg-bk-divider"></span></span><div class="min-w-0 flex-1 pb-bk-sm text-left"><p class="flex flex-wrap items-baseline gap-x-2"><span class="font-bk-display text-sm font-black text-bk-ink">Top</span><span class="font-bk-body text-xs text-bk-ink-soft">the moment you spray</span></p><p class="mt-0.5 font-bk-body text-sm leading-relaxed text-bk-ink">الليمون, الماندرين, البرغموت</p></div></li><li data-stage="heart" class="flex gap-3"><span aria-hidden="true" class="relative flex w-3 shrink-0 justify-center"><span class="mt-1 h-3 w-3 rounded-bk-pill border-bk-bold border-bk-ink bg-bk-surface"></span><span class="absolute bottom-0 top-5 w-px bg-bk-divider"></span></span><div class="min-w-0 flex-1 pb-bk-sm text-left"><p class="flex flex-wrap items-baseline gap-x-2"><span class="font-bk-display text-sm font-black text-bk-ink">Heart</span><span class="font-bk-body text-xs text-bk-ink-soft">once it settles</span></p><p class="mt-0.5 font-bk-body text-sm leading-relaxed text-bk-ink">التفاح, الرقي, الكراميل