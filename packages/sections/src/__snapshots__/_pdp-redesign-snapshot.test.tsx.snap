exports[`image_gallery + accordion_richtext — redesign draft (slice 1d) > guarantee card, ar 1`] = `"<section class="px-4 py-bk-section"><article id="guarantee" data-guarantee-card="true" class="relative isolate scroll-mt-24 overflow-hidden rounded-bk-card bg-bk-secondary text-bk-on-secondary"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.35" aria-hidden="true" class="pointer-events-none absolute -left-10 -top-10 -z-10 size-44 text-bk-on-secondary/[0.08]"><g transform="translate(50 50)"><ellipse rx="46" ry="16" transform="rotate(0)"></ellipse><ellipse rx="46" ry="16" transform="rotate(15)"></ellipse><ellipse rx="46" ry="16" transform="rotate(30)"></ellipse><ellipse rx="46" ry="16" transform="rotate(45)"></ellipse><ellipse rx="46" ry="16" transform="rotate(60)"></ellipse><ellipse rx="46" ry="16" transform="rotate(75)"></ellipse><ellipse rx="46" ry="16" transform="rotate(90)"></ellipse><ellipse rx="46" ry="16" transform="rotate(105)"></ellipse><ellipse rx="46" ry="16" transform="rotate(120)"></ellipse><ellipse rx="46" ry="16" transform="rotate(135)"></ellipse><ellipse rx="46" ry="16" transform="rotate(150)"></ellipse><ellipse rx="46" ry="16" transform="rotate(165)"></ellipse><circle r="48"></circle><circle r="12"></circle></g></svg><div class="px-5 pb-bk-sm pt-6"><div class="flex flex-col gap-bk-xs items-end text-right"><span data-i18n-field="eyebrow_i18n" class="inline-flex rounded-bk-pill bg-bk-on-secondary/10 px-2.5 py-0.5 font-bk-body text-xs font-bold text-bk-primary">ويا كل طلب من شنايدر</span><h2 data-i18n-field="heading_i18n" class="font-bk-display text-bk-chapter font-black text-bk-on-secondary text-balance">كرت الضمان</h2><p data-i18n-field="sub_i18n" class="font-bk-body text-sm font-semibold text-bk-on-secondary/75">حقك مكتوب هنا قبل ما تطلب</p></div><ol class="mt-bk-md divide-y divide-bk-on-secondary/15"><li data-guarantee-term="0" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary flex-row-reverse text-right"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">1</span><span data-i18n-field="items[0].title_i18n">الدفع عند الاستلام</span></h3><div data-i18n-field="items[0].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-right">ما تدفع إلا بعد ما يوصلك العطر وتجرّبه من العيّنة الزجاجية اللي تجيك مجاناً ويا كل طلب.</p></div></li><li data-guarantee-term="1" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary flex-row-reverse text-right"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">2</span><span data-i18n-field="items[1].title_i18n">تفحصه والمندوب يمّك</span></h3><div data-i18n-field="items[1].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-right">تتأكد من الجودة والمواصفات والفوحان والثبات قدّام المندوب. أي اختلاف، ترفضه وترجعلك قيمته كاملة.</p></div></li><li data-guarantee-term="2" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary flex-row-reverse text-right"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">3</span><span data-i18n-field="items[2].title_i18n">أسبوع تجربة ببيتك</span></h3><div data-i18n-field="items[2].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-right">تستعمل العطر وتخلّيه يمّك أسبوع كامل من يوم الاستلام. إذا ما عجبتك ريحته أو لگيت فرق بالمواصفات، ترجّعه ونرجعلك فلوسه.</p></div></li><li data-guarantee-term="3" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary flex-row-reverse text-right"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">4</span><span data-i18n-field="items[3].title_i18n">عطور أصلية</span></h3><div data-i18n-field="items[3].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-right">كل عطورنا مختارة بإيدنا وبعناية من أفخم المصادر العالمية ومن أجود الخامات العطرية. ما نتعامل بالعطور التركية المصنّعة بالجملة ولا الصينية الرديئة.</p></div></li></ol></div><div class="relative border-t-[1.5px] border-dashed border-bk-on-secondary/30"><span aria-hidden="true" class="absolute -left-3 -top-3 size-6 rounded-bk-pill bg-bk-surface"></span><span aria-hidden="true" class="absolute -right-3 -top-3 size-6 rounded-bk-pill bg-bk-surface"></span><a data-i18n-field="policy_link.label_i18n" class="flex min-h-12 items-center justify-between gap-2.5 px-6 py-2 font-bk-body text-sm font-bold text-bk-on-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus flex-row-reverse" href="/s/fixture-store/policies/returns"><span class="underline decoration-bk-primary/60 decoration-[1.5px] underline-offset-4">سياسة الإرجاع الكاملة</span><span class="material-symbols-outlined text-lg text-bk-primary" aria-hidden="true">arrow_back</span></a></div></article></section>"`;

exports[`image_gallery + accordion_richtext — redesign draft (slice 1d) > guarantee card, en 1`] = `"<section class="px-4 py-bk-section"><article id="guarantee" data-guarantee-card="true" class="relative isolate scroll-mt-24 overflow-hidden rounded-bk-card bg-bk-secondary text-bk-on-secondary"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.35" aria-hidden="true" class="pointer-events-none absolute -left-10 -top-10 -z-10 size-44 text-bk-on-secondary/[0.08]"><g transform="translate(50 50)"><ellipse rx="46" ry="16" transform="rotate(0)"></ellipse><ellipse rx="46" ry="16" transform="rotate(15)"></ellipse><ellipse rx="46" ry="16" transform="rotate(30)"></ellipse><ellipse rx="46" ry="16" transform="rotate(45)"></ellipse><ellipse rx="46" ry="16" transform="rotate(60)"></ellipse><ellipse rx="46" ry="16" transform="rotate(75)"></ellipse><ellipse rx="46" ry="16" transform="rotate(90)"></ellipse><ellipse rx="46" ry="16" transform="rotate(105)"></ellipse><ellipse rx="46" ry="16" transform="rotate(120)"></ellipse><ellipse rx="46" ry="16" transform="rotate(135)"></ellipse><ellipse rx="46" ry="16" transform="rotate(150)"></ellipse><ellipse rx="46" ry="16" transform="rotate(165)"></ellipse><circle r="48"></circle><circle r="12"></circle></g></svg><div class="px-5 pb-bk-sm pt-6"><div class="flex flex-col gap-bk-xs items-start text-left"><span data-i18n-field="eyebrow_i18n" class="inline-flex rounded-bk-pill bg-bk-on-secondary/10 px-2.5 py-0.5 font-bk-body text-xs font-bold text-bk-primary">With every Scheniders order</span><h2 data-i18n-field="heading_i18n" class="font-bk-display text-bk-chapter font-black text-bk-on-secondary text-balance">Guarantee card</h2><p data-i18n-field="sub_i18n" class="font-bk-body text-sm font-semibold text-bk-on-secondary/75">Your rights, in writing, before you order</p></div><ol class="mt-bk-md divide-y divide-bk-on-secondary/15"><li data-guarantee-term="0" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary text-left"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">1</span><span data-i18n-field="items[0].title_i18n">Pay on delivery</span></h3><div data-i18n-field="items[0].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-left">You pay only after the perfume reaches you and you have tried it from the glass sample that comes free with every order.</p></div></li><li data-guarantee-term="1" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary text-left"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">2</span><span data-i18n-field="items[1].title_i18n">Check it with the courier there</span></h3><div data-i18n-field="items[1].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-left">Check the quality, the description, the projection and the longevity in front of the courier. Anything different, refuse it and get your money back in full.</p></div></li><li data-guarantee-term="2" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary text-left"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">3</span><span data-i18n-field="items[2].title_i18n">A week&#x27;s trial at home</span></h3><div data-i18n-field="items[2].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-left">Use the perfume and keep it for a full week from delivery. If you don&#x27;t like the scent or find it differs from the description, return it and we refund you.</p></div></li><li data-guarantee-term="3" class="py-3.5 first:pt-1"><h3 class="flex items-center gap-2.5 font-bk-display text-base font-extrabold leading-snug text-bk-on-secondary text-left"><span data-guarantee-num="true" aria-hidden="true" class="inline-flex size-6 shrink-0 items-center justify-center rounded-bk-pill border-[1.5px] border-current text-xs font-black tabular-nums text-bk-primary">4</span><span data-i18n-field="items[3].title_i18n">Authentic perfumes</span></h3><div data-i18n-field="items[3].body_i18n" class="mt-1 space-y-2"><p class="whitespace-pre-line font-bk-body text-sm leading-relaxed text-bk-on-secondary/90 text-pretty text-left">Every perfume is hand-picked with care from the finest sources in the world and the best aromatic materials. We never deal in bulk-made Turkish or low-grade Chinese perfumes.</p></div></li></ol></div><div class="relative border-t-[1.5px] border-dashed border-bk-on-secondary/30"><span aria-hidden="true" class="absolute -left-3 -top-3 size-6 rounded-bk-pill bg-bk-surface"></span><span aria-hidden="true" class="absolute -right-3 -top-3 size-6 rounded-bk-pill bg-bk-surface"></span><a data-i18n-field="policy_link.label_i18n" class="flex min-h-12 items-center justify-between gap-2.5 px-6 py-2 font-bk-body text-sm font-bold text-bk-on-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus" href="/s/fixture-store/policies/returns"><span class="underline decoration-bk-primary/60 decoration-[1.5px] underline-offset-4">Full return policy</span><span class="material-symbols-outlined text-lg text-bk-primary" aria-hidden="true">arrow_forward</span></a></div></article></section>"`;

exports[`image_gallery + accordion_richtext — redesign draft (slice 1d) > proof stack, ar 1`] = `"<section class="px-4 py-bk-section"><div class="mb-bk-md flex flex-col gap-bk-2xs items-end text-right"><h2 data-i18n-field="heading_i18n" class="font-bk-display text-bk-chapter font-black text-bk-ink text-balance">كلامهم مو كلامنا</h2></div><div><div><div class="mb-bk-lg flex flex-col gap-bk-xs items-end"><span data-proof-source="true" data-i18n-field="source_label_i18n" class="inline-flex min-h-7 items-center gap-1.5 rounded-bk-pill border-bk border-bk-divider bg-bk-surface-alt px-2.5 py-0.5 font-bk-body text-[13px] font-bold text-bk-ink flex-row-reverse"><span class="material-symbols-outlined text-base" aria-hidden="true">forum</span>تعليقات على إعلاناتنا بتيك توك</span><p class="font-bk-body text-[13px] font-semibold text-bk-ink-soft text-right">3 من أصل 9، على عطورنا بشكل عام</p></div><ol class="flex flex-col gap-bk-xl"><li data-proof-item="0" class="flex flex-col"><p data-proof-doubt="1" class="mb-1.5 flex items-center gap-2.5 font-bk-body text-sm font-extrabold text-bk-ink-soft flex-row-reverse text-right"><span aria-hidden="true" class="inline-flex size-[26px] shrink-0 items-center justify-center rounded-bk-pill bg-bk-secondary text-[13px] font-black tabular-nums text-bk-primary">1</span><span>خايف يطلع مثل كل إعلان؟</span></p><p data-proof-quote="true" class="mb-1 font-bk-display text-[20px] font-black leading-snug text-bk-ink text-pretty text-right">«اول مره يوصلني عطر ويطلع كلام الاعلان كله صحيح»</p><p class="mb-bk-xs flex items-center gap-2 font-bk-body text-[13px] font-bold text-bk-ink [overflow-wrap:anywhere] flex-row-reverse text-right"><bdi>المحامي زياد طارق الحديدي</bdi></p><button type="button" data-gallery-open="0" aria-haspopup="dialog" aria-label="كبّر الصورة: تعليق المحامي زياد طارق الحديدي: وصلني العطر فعلاً راقي و اول مره يوصلني عطر ويطلع كلام الاعلان كله صحيح عاشت ايدك حبي وان شاءالله بعد منه ورايح عطوري من يمكم" class="relative block w-full ove