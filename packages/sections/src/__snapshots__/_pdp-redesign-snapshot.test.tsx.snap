ffset-2 focus-visible:ring-offset-bk-surface disabled:cursor-not-allowed disabled:bg-bk-primary-disabled disabled:shadow-none hover:bg-bk-primary-hover active:scale-[0.97] active:bg-bk-primary-active active:shadow-none"><span aria-hidden="true" class="bk-xp-sheen pointer-events-none absolute inset-y-0 left-0 -z-10 w-2/5"></span><span class="font-bk-display text-[19px] font-black leading-tight">Place my order</span><span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-bk-pill bg-bk-on-primary/15"><span class="material-symbols-outlined text-xl bk-xp-nudge" aria-hidden="true">arrow_forward</span></span></button></div><div data-promise-band="true"><ul aria-label="What you get with your order" class="divide-y divide-bk-on-secondary/15 rounded-bk-card bg-bk-secondary px-4 py-1 text-bk-on-secondary"><li data-promise-row="trust" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">verified_user</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug" data-i18n-field="reassurance_i18n">Open it and try it before you pay. Tester included.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80"><span data-i18n-field="return_promise_i18n">Don&#x27;t like it? Refuse it in front of the courier, or return it within a week.</span> <a href="#guarantee" class="relative inline-block font-bold text-bk-on-secondary underline underline-offset-2 before:absolute before:-inset-x-2 before:-inset-y-[14px] before:content-[&#x27;&#x27;] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus">Terms</a></p></div></li><li data-promise-row="delivery" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">local_shipping</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">Delivery is free.</p><p class="font-bk-body text-[13px] leading-snug text-bk-on-secondary/80" data-i18n-field="delivery_sla_i18n">Most orders arrive within 24 hours of confirmation</p></div></li><li data-promise-row="call" class="flex min-h-11 items-start gap-3 py-2.5"><span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-bk-primary" aria-hidden="true">call</span><div class="min-w-0 flex-1 space-y-1 text-left"><p class="font-bk-body text-[15px] font-bold leading-snug">You&#x27;ll get a call from <bdi class="whitespace-nowrap">0777 970 3832</bdi> to confirm your order. Answer it and your order ships.</p><a href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0D%0AVERSION%3A3.0%0D%0AN%3AScheniders%20%E2%80%94%20order%20confirmation%3B%3B%3B%3B%0D%0AFN%3AScheniders%20%E2%80%94%20order%20confirmation%0D%0ATEL%3BTYPE%3DCELL%2CVOICE%3A%2B9647779703832%0D%0AEND%3AVCARD" download="Scheniders — order confirmation.vcf" data-save-number="true" class="inline-flex min-h-11 items-center gap-1.5 rounded-bk-pill border-bk border-bk-on-secondary/40 px-3 font-bk-body text-[13px] font-bold text-bk-on-secondary transition-colors duration-bk-fast hover:bg-bk-on-secondary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus motion-reduce:transition-none"><span class="material-symbols-outlined text-base" aria-hidden="true">person_add</span>Save our number</a></div></li></ul><p aria-live="polite" data-save-hint="true" class="mt-bk-xs text-center font-bk-body text-[13px] font-bold text-bk-ink-soft sr-only"></p></div></div></form><section data-scent-card="" aria-labelledby="_R_27_" class="space-y-bk-sm rounded-bk-card bg-bk-surface-alt p-4"><div class="flex items-center justify-between gap-2"><h2 id="_R_27_" class="font-bk-body text-xs font-black text-bk-ink-soft">Scent profile</h2><span class="inline-flex h-7 items-center gap-1 rounded-bk-pill px-2.5 font-bk-body text-xs font-bold border-bk border-bk-divider text-bk-ink-soft"><span class="material-symbols-outlined text-sm" aria-hidden="true">man</span>Men</span></div><p data-scent-lead="" class="font-bk-display text-[17px] font-extrabold leading-snug text-bk-ink text-balance text-left">فاكهي بلمسة توابل: يبدي بالتوت والتفاح، ويظل عليك بالباتشولي</p><ol aria-label="Scent notes" class="divide-y divide-bk-divider"><li data-stage="top" class="flex items-center gap-3 py-3"><p class="w-20 shrink-0 text-left"><span class="block font-bk-display text-sm font-black text-bk-ink">Top</span><span class="block font-bk-body text-xs font-semibold text-bk-ink-soft">the moment you spray</span></p><ul class="flex min-w-0 flex-1 flex-wrap items-start gap-3"><li data-note-photo="" class="flex w-[4.5rem] flex-col items-center gap-1 text-center"><img alt="" loading="lazy" width="60" height="60" decoding="async" data-nimg="1" class="h-[60px] w-[60px] rounded-bk-pill object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fsduvpgqwhxragxtxztur.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftenant-assets%2Fstore-templates%2Fscheniders%2Fnote-cards%2Fd988d98ad981-0.jpg&amp;w=64&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fsduvpgqwhxragxtxztur.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftenant-assets%2Fstore-templates%2Fscheniders%2Fnote-cards%2Fd988d98ad981-0.jpg&amp;w=128&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fsduvpgqwhxragxtxztur.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftenant-assets%2Fstore-templates%2Fscheniders%2Fnote-cards%2Fd988d98ad981-0.jpg&amp;w=128&amp;q=75"/><span class="font-bk-body text-xs font-bold leading-tight text-bk-ink">التوت الفاخر</span></li><li data-note-photo="" class="flex w-[4.5rem] flex-col items-center gap-1 text-center"><img alt="" loading="lazy" width="60" height="60" decoding="async" data-nimg="1" class="h-[60px] w-[60px] rounded-bk-pill object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fsduvpgqwhxragxtxztur.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic