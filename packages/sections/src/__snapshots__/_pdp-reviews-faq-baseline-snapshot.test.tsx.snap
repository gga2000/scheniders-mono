L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">تأخر علية المندوب يومين يلا جابه فدوة نبهو ع مندوبين دهوك العطر كلش راقي وثباته يطول يوم كامل على الملابس جان انطيتكم تقييم 5 نجوم العطر يستاهل 10 نجوم مو بس خمسة بس علمود سالفة التوصيل راح انطيه تلث نجوم</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md text-right"><div class="flex items-center justify-between gap-bk-sm flex-row-reverse"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">حازم السيد</span><span role="img" aria-label="5 من 5" class="inline-flex items-center gap-0.5 shrink-0 flex-row-reverse"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">هذا ثاني عطر اطلبه منهم، الاول هذاك بيسفون مدري شسمه  وهسة جربت الانتنس. ريحته حمضيات ع انتعاش ع سوسن بالبداية وبعدين تصير فخمة. تغليفهم يبيض الوجه اذا تريده تهديه.</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md text-right"><div class="flex items-center justify-between gap-bk-sm flex-row-reverse"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">ياسين</span><span role="img" aria-label="5 من 5" class="inline-flex items-center gap-0.5 shrink-0 flex-row-reverse"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">اللي سوة الفيديو اذا الزمه الة اشبعه كتل، ياخي شبليتني من بلوة اشتريته وخليته بالسيارة بنفس اليوم قطوه مني، مرتي شمته بية تعال اريد منه اخوي شمه تعال جيبلي واحد، هذاك واحد طار وهذن ثنين وصيت واحد الية ولمرتي نشارك بيه والثاني لاخوي اذا منطيتوني هدية نزاعل</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md text-right"><div class="flex items-center justify-between gap-bk-sm flex-row-reverse"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">eng. سيف</span><span role="img" aria-label="5 من 5" class="inline-flex items-center gap-0.5 shrink-0 flex-row-reverse"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">بدون مبالغة وكلاوات العيد كريحة العطر جبار الفوحان انطيه 8 ونص من عشرة بس الثبات يا اخي ابدااااااع، كله اشتري عطور بمية ومية وخمسين بس ممحصل منهم بكد ثبات هذا الويفر وبخيت منه الصبح لسه الريحة تفوح. انصح بي وبشدة للشباب.</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md text-right"><div class="flex items-center justify-between gap-bk-sm flex-row-reverse"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">مصطفى علي</span><span role="img" aria-label="5 من 5" class="inline-flex items-center gap-0.5 shrink-0 flex-row-reverse"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">عاشت ايدكم العطر يخبل، جربت التيستر اول شي وكلش عجبتنئ ريحته، العطر صدمني بثباته اهنيكم ع هيج شغل</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md text-right"><div class="flex items-center justify-between gap-bk-sm flex-row-reverse"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">احمد الشمري</span><span role="img" aria-label="5 من 5" class="inline-flex items-center gap-0.5 shrink-0 flex-row-reverse"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">بصراحة جنت خايف اطلب لان الغش ما شاء الله بالبيجات صاير بالجملة، بس وصلتني العلبة مرتبة والتيستر فكرة تخبل. الريحة فخمة مال واحد مدير هههه. شكراً الكم ع المصداقية راح اكرر تجربة الشراء منكم مرة ثانية بس خل ينزل الراتب.</p></li></ul><dialog class="m-auto max-h-[100dvh] max-w-[100vw] bg-transparent p-0 backdrop:bg-bk-ink/80 open:flex open:items-center open:justify-center"></dialog><div class="mt-bk-md flex justify-end"><button type="button" data-review-entry="" class="inline-flex min-h-11 items-center gap-2 rounded-bk-pill border-bk border-bk-divider bg-bk-surface px-bk-md font-bk-body text-sm font-bold text-bk-ink transition-[opacity,transform] duration-bk-fast motion-reduce:transition-none hover:opacity-90 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 ring-bk-focus ring-offset-2 flex-row-reverse"><span class="material-symbols-outlined text-base" aria-hidden="true">edit</span>اكتب تقييمك</button></div></section>"`;

exports[`product_reviews — scheniders-iraq draft quiet layout, frozen > en 1`] = `"<section class="px-4 py-bk-section" id="reviews"><div class="mb-bk-lg flex flex-col gap-bk-xs items-start text-start"><h2 data-i18n-field="heading_i18n" class="font-display font-black text-balance text-bk-h2" style="color:var(--bk-ink, #1a1a1a);font-family:var(--bk-font-display, inherit)">Customer reviews</h2></div><div data-reviews-summary="" class="mt-bk-md flex items-center gap-bk-md rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex shrink-0 flex-col items-center gap-1"><span class="font-bk-display text-5xl font-black leading-none text-bk-ink tabular-nums"><bdi>4.7</bdi></span><span role="img" aria-label="Rated 4.7 out of 5" class="inline-flex items-center gap-0.5"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span><span class="font-bk-body text-xs font-bold text-bk-ink-soft tabular-nums">6 reviews</span></div><ul aria-label="Reviews by star rating" class="min-w-0 flex-1 space-y-1.5"><li aria-label="5 of 5: 5 reviews" class="flex items-center gap-bk-xs"><span aria-hidden="true" class="w-3 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums">5</span><span aria-hidden="true" class="flex h-1.5 flex-1 overflow-hidden rounded-bk-pill bg-bk-ink/10"><span class="block h-full rounded-bk-pill bg-bk-ink" style="width:83.33333333333334%"></span></span><span aria-hidden="true" class="w-4 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums" data-star-count="5">5</span></li><li aria-label="4 of 5: 0 reviews" class="flex items-center gap-bk-xs"><span aria-hidden="true" class="w-3 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums">4</span><span aria-hidden="true" class="flex h-1.5 flex-1 overflow-hidden rounded-bk-pill bg-bk-ink/10"><span class="block h-full rounded-bk-pill bg-bk-ink" style="width:0%"></span></span><span aria-hidden="true" class="w-4 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums" data-star-count="4">0</span></li><li aria-label="3 of 5: 1 reviews" class="flex items-center gap-bk-xs"><span aria-hidden="true" class="w-3 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums">3</span><span aria-hidden="true" class="flex h-1.5 flex-1 overflow-hidden rounded-bk-pill bg-bk-ink/10"><span class="block h-full rounded-bk-pill bg-bk-ink" style="width:16.666666666666664%"></span></span><span aria-hidden="true" class="w-4 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums" data-star-count="3">1</span></li><li aria-label="2 of 5: 0 reviews" class="flex items-center gap-bk-xs"><span aria-hidden="true" class="w-3 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums">2</span><span aria-hidden="true" class="flex h-1.5 flex-1 overflow-hidden rounded-bk-pill bg-bk-ink/10"><span class="block h-full rounded-bk-pill bg-bk-ink" style="width:0%"></span></span><span aria-hidden="true" class="w-4 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums" data-star-count="2">0</span></li><li aria-label="1 of 5: 0 reviews" class="flex items-center gap-bk-xs"><span aria-hidden="true" class="w-3 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums">1</span><span aria-hidden="true" class="flex h-1.5 flex-1 overflow-hidden rounded-bk-pill bg-bk-ink/10"><span class="block h-full rounded-bk-pill bg-bk-ink" style="width:0%"></span></span><span aria-hidden="true" class="w-4 text-center font-bk-body text-xs text-bk-ink-soft tabular-nums" data-star-count="1">0</span></li></ul></div><ul class="mt-bk-md space-y-bk-sm"><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">Ahmed</span><span role="img" aria-label="3 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-ink-faint, rgb(26 26 26 / 0.25))"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-ink-faint, rgb(26 26 26 / 0.25))"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">تأخر علية المندوب يومين يلا جابه فدوة نبهو ع مندوبين دهوك العطر كلش راقي وثباته يطول يوم كامل على الملابس جان انطيتكم تقييم 5 نجوم العطر يستاهل 10 نجوم مو بس خمسة بس علمود سالفة التوصيل راح انطيه تلث نجوم</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">حازم السيد</span><span role="img" aria-label="5 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">هذا ثاني عطر اطلبه منهم، الاول هذاك بيسفون مدري شسمه  وهسة جربت الانتنس. ريحته حمضيات ع انتعاش ع سوسن بالبداية وبعدين تصير فخمة. تغليفهم يبيض الوجه اذا تريده تهديه.</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">ياسين</span><span role="img" aria-label="5 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">اللي سوة الفيديو اذا الزمه الة اشبعه كتل، ياخي شبليتني من بلوة اشتريته وخليته بالسيارة بنفس اليوم قطوه مني، مرتي شمته بية تعال اريد منه اخوي شمه تعال جيبلي واحد، هذاك واحد طار وهذن ثنين وصيت واحد الية ولمرتي نشارك بيه والثاني لاخوي اذا منطيتوني هدية نزاعل</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">eng. سيف</span><span role="img" aria-label="5 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">بدون مبالغة وكلاوات العيد كريحة العطر جبار الفوحان انطيه 8 ونص من عشرة بس الثبات يا اخي ابدااااااع، كله اشتري عطور بمية ومية وخمسين بس ممحصل منهم بكد ثبات هذا الويفر وبخيت منه الصبح لسه الريحة تفوح. انصح بي وبشدة للشباب.</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">مصطفى علي</span><span role="img" aria-label="5 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">عاشت ايدكم العطر يخبل، جربت التيستر اول شي وكلش عجبتنئ ريحته، العطر صدمني بثباته اهنيكم ع هيج شغل</p></li><li class="rounded-bk-card border-bk border-bk-divider bg-bk-surface p-bk-md"><div class="flex items-center justify-between gap-bk-sm"><span class="min-w-0 truncate font-bk-body text-sm font-bold text-bk-ink">احمد الشمري</span><span role="img" aria-label="5 out of 5" class="inline-flex items-center gap-0.5 shrink-0"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" fill="var(--bk-accent, #ffd84a)"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"></path></svg></span></div><p class="mt-bk-xs font-bk-body text-sm leading-relaxed text-bk-ink-soft text-pretty">بصراحة جنت خايف اطلب لان الغش ما شاء الله بالبيجات صاير بالجملة، بس وصلتني العلبة مرتبة والتيستر فكرة تخبل. الريحة فخمة مال واحد مدير هههه. شكراً الكم ع المصداقية راح اكرر تجربة الشراء منكم مرة ثانية بس خل ينزل الراتب.</p></li></ul><dialog class="m-auto max-h-[100dvh] max-w-[100vw] bg-transparent p-0 backdrop:bg-bk-ink/80 open:flex open:items-center open:justify-center"></dialog><div class="mt-bk-md flex"><button type="button" data-review-entry="" class="inline-flex min-h-11 items-center gap-2 rounded-bk-pill border-bk border-bk-divider bg-bk-surface px-bk-md font-bk-body text-sm font-bold text-bk-ink transition-[opacity,transform] duration-bk-fast motion-reduce:transition-none hover:opacity-90 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 ring-bk-focus ring-offset-2"><span class="material-symbols-outlined text-base" aria-hidden="true">edit</span>Write your review</button></div></section>"`;
