exports[`faq_contact_split — scheniders-iraq draft compact + WhatsApp row, frozen > ar 1`] = `"<section class="px-4 py-bk-section-dense"><h2 data-i18n-field="title_i18n" class="mb-bk-sm font-bk-display text-lg font-black text-bk-ink text-balance text-right">الأسئلة الأكثر شيوعا</h2><div class="divide-y divide-bk-divider border-y border-bk-divider"><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden flex-row-reverse"><span data-i18n-field="items[0].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">العطور أصلية؟</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[0].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pl-8 text-right">كل عطورنا مختارة يدوياً من أفخم المصادر العالمية ومن أجود الخامات العطرية، ونجرّب كل عطر بأنفسنا قبل ما يوصلك. وما نتعامل بالعطور التركية المصنّعة بالجملة ولا بالعطور الصينية الرديئة.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden flex-row-reverse"><span data-i18n-field="items[1].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">ريحة العطر نفس ريحة التيستر؟</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[1].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pl-8 text-right">تجرّب العطر بالتيستر الزجاجي المجاني اللي يجي ويا طلبك، بحضور المندوب وقبل لا تدفع. وإذا لگيت أي اختلاف بالجودة أو المواصفات أو الفوحان أو الثبات، يحقلك ترفض العطر. وإذا اكتشفت فرق بالمواصفات بعد الاستلام، تگدر ترجّعه خلال أسبوع.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden flex-row-reverse"><span data-i18n-field="items[2].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">إذا ما عجبني العطر وقت الاستلام؟</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[2].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pl-8 text-right">ما تدفع إلا بعد ما تستلم العطر وتجرّبه بالتيستر. وإذا استلمته وما عجبتك التجربة العطرية، يحقلك ترجّعه خلال أسبوع من الاستلام: راسلنا على الواتساب ونرتّب الاسترجاع، وتفاصيل الشروط موجودة بصفحة سياسة الاسترجاع.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden flex-row-reverse"><span data-i18n-field="items[3].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">شكد يطول التوصيل؟</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[3].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pl-8 text-right">أغلب الطلبات توصل خلال ٢٤ ساعة من تثبيت الطلب، والمحافظات البعيدة ممكن توصل لحد ٣ أيام عمل. والتوصيل مجاني لكل المحافظات.</p></details></div><div data-action-row="whatsapp" class="mt-bk-sm flex items-center gap-3 rounded-bk-card bg-bk-surface-alt px-4 py-3 flex-row-reverse"><div class="min-w-0 flex-1 text-right"><p data-i18n-field="contact.title_i18n" class="font-bk-body text-sm font-bold leading-snug text-bk-ink text-balance">عندك استفسار؟</p><p data-i18n-field="contact.sub_i18n" class="font-bk-body text-xs leading-relaxed text-bk-ink-soft text-pretty">نورونا على الواتساب وسولفوا ويانا</p></div><a href="https://wa.me/9647779703832" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-bk-pill border-bk border-bk-ink bg-bk-surface px-4 font-bk-display text-sm font-black text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="h-5 w-5 shrink-0 text-bk-success" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 3.825.001 6.938 3.113 6.938 6.938-.001 3.825-3.113 6.938-6.938 6.938z"></path></svg><span data-i18n-field="contact.cta_label_i18n">واتساب</span></a></div></section>"`;

exports[`faq_contact_split — scheniders-iraq draft compact + WhatsApp row, frozen > en 1`] = `"<section class="px-4 py-bk-section-dense"><h2 data-i18n-field="title_i18n" class="mb-bk-sm font-bk-display text-lg font-black text-bk-ink text-balance text-left">Frequently asked questions</h2><div class="divide-y divide-bk-divider border-y border-bk-divider"><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden"><span data-i18n-field="items[0].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-left">Are your perfumes original?</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[0].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pr-8 text-left">Every perfume is hand-picked from premium global sources and the finest aromatic materials, and we try each one ourselves before it reaches you. We don&#x27;t deal in bulk-made Turkish perfumes or low-grade Chinese ones.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden"><span data-i18n-field="items[1].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-left">Will the bottle smell like the tester?</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[1].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pr-8 text-left">You try the perfume with the free glass tester that comes with your order, with the courier there and before you pay. If anything differs (quality, specs, projection or longevity) you can refuse it. If you find a difference in the specs after delivery, you can return it within a week.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden"><span data-i18n-field="items[2].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-left">What if I don&#x27;t like it when it arrives?</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[2].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pr-8 text-left">You only pay after you receive the perfume and try it with the tester. If you keep it and don&#x27;t like the scent, you can return it within a week of delivery: message us on WhatsApp and we&#x27;ll arrange the return. The conditions are on the returns policy page.</p></details><details name="faq-_R_0_" class="group"><summary class="flex min-h-14 w-full cursor-pointer list-none items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none [&amp;::-webkit-details-marker]:hidden"><span data-i18n-field="items[3].q_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-left">How long does delivery take?</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true">expand_more</span></summary><p data-i18n-field="items[3].a_i18n" dir="auto" class="whitespace-pre-line pb-5 font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty pr-8 text-left">Most orders arrive within 24 hours of confirmation; far governorates can take up to 3 working days. Delivery is free to every governorate.</p></details></div><div data-action-row="whatsapp" class="mt-bk-sm flex items-center gap-3 rounded-bk-card bg-bk-surface-alt px-4 py-3"><div class="min-w-0 flex-1 text-left"><p data-i18n-field="contact.title_i18n" class="font-bk-body text-sm font-bold leading-snug text-bk-ink text-balance">Any questions?</p><p data-i18n-field="contact.sub_i18n" class="font-bk-body text-xs leading-relaxed text-bk-ink-soft text-pretty">Message us on WhatsApp, we&#x27;re happy to chat.</p></div><a href="https://wa.me/9647779703832" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-bk-pill border-bk border-bk-ink bg-bk-surface px-4 font-bk-display text-sm font-black text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="h-5 w-5 shrink-0 text-bk-success" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 3.825.001 6.938 3.113 6.938 6.938-.001 3.825-3.113 6.938-6.938 6.938z"></path></svg><span data-i18n-field="contact.cta_label_i18n">WhatsApp</span></a></div></section>"`;

