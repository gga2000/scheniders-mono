exports[`accordion_richtext — scheniders-iraq draft quiet + call row, frozen > ar 1`] = `"<section class="px-4 py-bk-section-dense"><div class="divide-y divide-bk-divider border-y border-bk-divider"><div><button type="button" aria-expanded="false" aria-controls="_R_1_-p0" class="flex min-h-14 w-full items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><span data-i18n-field="items[0].title_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">سياسة الدفع عند الاستلام</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out motion-reduce:transition-none" aria-hidden="true">expand_more</span></button><div id="_R_1_-p0" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="min-h-0 overflow-hidden" inert=""><div data-i18n-field="items[0].body_i18n" class="space-y-3 pb-5 transition-opacity duration-bk-base motion-reduce:transition-none pl-8 opacity-0"><p dir="auto" class="whitespace-pre-line font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty text-right">يتم الدفع حصراً بعد استلام العطر واختباره من خلال العينة الزجاجية المرفقة مجاناُ مع كل طلب.</p></div></div></div></div><div><button type="button" aria-expanded="false" aria-controls="_R_1_-p1" class="flex min-h-14 w-full items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><span data-i18n-field="items[1].title_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">شحن فائق السرعة</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out motion-reduce:transition-none" aria-hidden="true">expand_more</span></button><div id="_R_1_-p1" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="min-h-0 overflow-hidden" inert=""><div data-i18n-field="items[1].body_i18n" class="space-y-3 pb-5 transition-opacity duration-bk-base motion-reduce:transition-none pl-8 opacity-0"><p dir="auto" class="whitespace-pre-line font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty text-right">أغلب الطلبات توصل خلال ٢٤ ساعة من تثبيت الطلب.</p></div></div></div></div><div><button type="button" aria-expanded="false" aria-controls="_R_1_-p2" class="flex min-h-14 w-full items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><span data-i18n-field="items[2].title_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">كرت الضمان المميز و سياسة الاسترجاع</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out motion-reduce:transition-none" aria-hidden="true">expand_more</span></button><div id="_R_1_-p2" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="min-h-0 overflow-hidden" inert=""><div data-i18n-field="items[2].body_i18n" class="space-y-3 pb-5 transition-opacity duration-bk-base motion-reduce:transition-none pl-8 opacity-0"><p dir="auto" class="whitespace-pre-line font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty text-right">عند استلام المنتج يتم التأكد من الجودة والمواصفات والفوحان والثبات بحضور المندوب, اي اختلاف يحق للزبون رفض المنتج ويتم ارجاع قيمته كاملة.</p><p dir="auto" class="whitespace-pre-line font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty text-right">ويحق للزبون استعمال العطر والاحتفاظ به لمدة اسبوع كامل من تاريخ استلام الطلب واختباره من راحة منزله. ان لم تعجبه التجربة العطرية او اكتشافه لفرق بالمواصفات المذكورة يحق له ارجاع العطر واستلام قيمته من قبلنا.</p></div></div></div></div><div><button type="button" aria-expanded="false" aria-controls="_R_1_-p3" class="flex min-h-14 w-full items-center gap-3 py-4 text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><span data-i18n-field="items[3].title_i18n" class="flex-1 font-bk-display text-base font-bold leading-snug text-balance text-right">عطور اصلية</span><span class="material-symbols-outlined shrink-0 text-xl text-bk-ink transition-transform duration-bk-base ease-out motion-reduce:transition-none" aria-hidden="true">expand_more</span></button><div id="_R_1_-p3" class="grid transition-[grid-template-rows] duration-bk-base ease-out motion-reduce:transition-none" style="grid-template-rows:0fr"><div class="min-h-0 overflow-hidden" inert=""><div data-i18n-field="items[3].body_i18n" class="space-y-3 pb-5 transition-opacity duration-bk-base motion-reduce:transition-none pl-8 opacity-0"><p dir="auto" class="whitespace-pre-line font-bk-body text-[15px] leading-loose text-bk-ink-soft text-pretty text-right">جميع عطورنا مختارة يدوياً وبعناية من افخم المصادر العالمية, ومن اجود انواع العطور والخامات العطرية. لا نتعامل بالعطور التركية المصنعة بالجملة او العطور الصينية الرديئة</p></div></div></div></div></div><div data-action-row="call" class="mt-bk-sm flex items-center gap-3 rounded-bk-card bg-bk-surface-alt px-4 py-3 flex-row-reverse"><div class="min-w-0 flex-1 text-right"><p data-i18n-field="call_row.prompt_i18n" class="font-bk-body text-sm font-bold leading-snug text-bk-ink text-balance">تحب تحچي ويانا؟</p><p class="font-bk-body text-xs tabular-nums text-bk-ink-soft"><bdi>0777 970 3832</bdi></p></div><a href="tel:+9647779703832" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-bk-pill border-bk border-bk-ink bg-bk-surface px-4 font-bk-display text-sm font-black text-bk-ink transition-opacity duration-bk-fast active:opacity-70 motion-reduce:transition-none flex-row-reverse"><span class="material-symbols-outlined shrink-0 text-lg" aria-hidden="true">call</span><span data-i18n-field="call_row.action_i18n">اتصل</span></a></div></section>"`;

