  100% { transform: translateX(360%) skewX(-18deg); }
}
@keyframes bk-xp-nudge {
  0%, 70%, 86%, 100% { transform: none; }
  78%, 93% { transform: translateX(var(--bk-xp-nudge)); }
}
@keyframes bk-xp-drop {
