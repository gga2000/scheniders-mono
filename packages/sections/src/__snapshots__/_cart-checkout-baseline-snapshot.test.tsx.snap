exports[`checkout page (frozen) > checkout_form, defaults, two lines, en 1`] = `"<section class="px-4 py-bk-section-dense"><div class="mx-auto max-w-2xl space-y-bk-md"><ol class="flex items-center justify-center gap-bk-xs font-label font-bold text-[11px] bk-caps tracking-[0.15em]"><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" style="color: var(--bk-ink-soft, rgb(26 26 26 / 0.7));">Cart</span><span aria-hidden="true" class="text-bk-ink-faint">›</span></li><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" aria-current="step" style="background-color: var(--bk-accent, #ffd84a); color: var(--bk-on-accent, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-pill, 9999px);">Details</span><span aria-hidden="true" class="text-bk-ink-faint">›</span></li><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" style="color: var(--bk-ink-soft, rgb(26 26 26 / 0.7));">Confirm</span></li></ol><div class="flex items-start gap-3 p-bk-md" style="background-color: color-mix(in srgb, var(--bk-accent, #ffd84a) 16%, transparent); color: var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-card, 1rem);"><span class="material-symbols-outlined text-2xl shrink-0" aria-hidden="true">call</span><div><p class="font-display font-black text-base leading-tight" data-i18n-field="call_promise_i18n">We'll call to confirm your order</p><p class="font-body text-sm leading-snug text-bk-ink-soft" data-i18n-field="call_promise_note_i18n">No upfront payment needed.</p></div></div><div class="p-bk-lg sm:p-bk-xl" style="background-color: var(--bk-surface, #ffffff); color: var(--bk-ink, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-card, 1rem); box-shadow: var(--bk-shadow-card, 4px 4px 0px 0px #1a1a1a);"><div class="mb-bk-lg flex flex-col gap-bk-xs items-start text-start mb-bk-md"><h1 class="font-display font-black text-balance text-bk-h1" s