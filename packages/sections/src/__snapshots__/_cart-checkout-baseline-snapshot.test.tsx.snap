exports[`checkout page (frozen) > checkout_form, defaults, two lines, ar 1`] = `"<section class="px-4 py-bk-section-dense"><div class="mx-auto max-w-2xl space-y-bk-md"><ol class="flex items-center justify-center gap-bk-xs font-label font-bold text-[11px] bk-caps tracking-[0.15em]"><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" style="color: var(--bk-ink-soft, rgb(26 26 26 / 0.7));">السلة</span><span aria-hidden="true" class="text-bk-ink-faint">›</span></li><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" aria-current="step" style="background-color: var(--bk-accent, #ffd84a); color: var(--bk-on-accent, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-pill, 9999px);">التفاصيل</span><span aria-hidden="true" class="text-bk-ink-faint">›</span></li><li class="flex items-center gap-bk-xs"><span class="px-2.5 py-1" style="color: var(--bk-ink-soft, rgb(26 26 26 / 0.7));">التأكيد</span></li></ol><div class="flex items-start gap-3 p-bk-md" style="background-color: color-mix(in srgb, var(--bk-accent, #ffd84a) 16%, transparent); color: var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-card, 1rem);"><span class="material-symbols-outlined text-2xl shrink-0" aria-hidden="true">call</span><div><p class="font-display font-black text-base leading-tight" data-i18n-field="call_promise_i18n">سنتصل بك لتأكيد الطلب</p><p class="font-body text-sm leading-snug text-bk-ink-soft" data-i18n-field="call_promise_note_i18n">لا حاجة لأي دفع مسبق.</p></div></div><div class="p-bk-lg sm:p-bk-xl" style="background-color: var(--bk-surface, #ffffff); color: var(--bk-ink, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-card, 1rem); box-shadow: var(--bk-shadow-card, 4px 4px 0px 0px #1a1a1a);"><div class="mb-bk-lg flex flex-col gap-bk-xs items-start text-start mb-bk-md"><h1 class="font-display font-black text-balance text-bk-h1" style="color: var(--bk-ink, #1a1a1a); font-family: var(--bk-font-display, inherit);">تفاصيل التوصيل</h1></div><form class="space-y-bk-sm"><label class="block"><span class="block font-label font-bold text-xs bk-caps tracking-[0.2em] text-bk-ink-soft mb-bk-2xs">الاسم الكامل</span><input autocomplete="name" required="" class="w-full px-3 py-3 font-body text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus" style="background-color: var(--bk-surface, #ffffff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); color: var(--bk-ink, #1a1a1a);" type="text" value="" name="name"></label><div><label class="block"><span class="block font-label font-bold text-xs bk-caps tracking-[0.2em] text-bk-ink-soft mb-bk-2xs">رقم الهاتف</span><div class="flex" dir="ltr"><span class="inline-flex items-center px-3 font-display font-black text-base shrink-0" style="background-color: color-mix(in srgb, var(--bk-accent, #ffd84a) 16%, transparent); color: var(--bk-ink, #1a1a1a); border-right: medium; border-radius: var(--bk-radius-input, 0.75rem) 0 0 var(--bk-radius-input, 0.75rem);">+964</span><input required="" inputmode="tel" autocomplete="tel-national" placeholder="770 000 0000" class="w-full px-3 py-3 font-body text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus" style="background-color: var(--bk-surface, #ffffff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: 0 var(--bk-radius-input, 0.75rem) var(--bk-radius-input, 0.75rem) 0; color: var(--bk-ink, #1a1a1a);" type="tel" value="" name="phone"></div></label></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-bk-sm"><label class="block"><span class="block font-label font-bold text-xs bk-caps tracking-[0.2em] text-bk-ink-soft mb-bk-2xs">المحافظة</span><select name="governorate" autocomplete="address-level1" required="" class="w-full px-3 py-3 font-body text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus" style="background-color: var(--bk-surface, #ffffff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); color: var(--bk-ink, #1a1a1a);"><option value="" disabled="">اختر المحافظة</option><option value="BG">بغداد</option><option value="BA">البصرة</option><option value="ER">أربيل</option><option value="SU">السليمانية</option><option value="DH">دهوك</option><option value="NI">نينوى</option><option value="KI">كركوك</option><option value="DI">ديالى</option><option value="AN">الأنبار</option><option value="BB">بابل</option><option value="KE">كربلاء</option><option value="NA">النجف</option><option value="QA">القادسية</option><option value="MU">المثنى</option><option value="DQ">ذي قار</option><option value="WA">واسط</option><option value="MA">ميسان</option><option value="SA">صلاح الدين</option></select></label><label class="block"><span class="block font-label font-bold text-xs bk-caps tracking-[0.2em] text-bk-ink-soft mb-bk-2xs">المنطقة</span><input autocomplete="address-level2" required="" class="w-full px-3 py-3 font-body text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus" style="background-color: var(--bk-surface, #ffffff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); color: var(--bk-ink, #1a1a1a);" type="text" value="" name="city"></label></div><label class="block"><span class="block font-label font-bold text-xs bk-caps tracking-[0.2em] text-bk-ink-soft mb-bk-2xs">العنوان بالتفصيل</span><textarea name="address" autocomplete="street-address" required="" rows="3" placeholder="الشارع، المحلة، رقم الدار…" class="w-full px-3 py-3 font-body text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bk-focus resize-y" style="background-color: var(--bk-surface, #ffffff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); color: var(--bk-ink, #1a1a1a);"></textarea></label><fieldset class="space-y-bk-xs pt-bk-2xs"><legend class="font-display font-black text-base bk-caps mb-bk-xs">طريقة الدفع</legend><div class="flex items-center gap-3 px-4 py-3" style="background-color: color-mix(in srgb, var(--bk-success, #7cf0bd) 18%, transparent); color: var(--bk-ink, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); box-shadow: var(--bk-shadow-button, 2px 2px 0px 0px #1a1a1a);"><span class="material-symbols-outlined text-2xl" aria-hidden="true">payments</span><span class="font-display font-black text-base bk-caps flex-1">الدفع عند الاستلام</span><span class="material-symbols-outlined text-2xl text-bk-success" aria-hidden="true">check_circle</span></div></fieldset><ul class="-mx-1 flex flex-wrap gap-bk-xs pt-bk-2xs"><li class="inline-flex items-center gap-2 px-3 py-1.5 font-label font-bold text-xs bk-caps" style="background-color: var(--bk-surface-alt, #f7f4ee); color: var(--bk-ink, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-pill, 9999px);"><span class="material-symbols-outlined text-base" aria-hidden="true">verified_user</span>طلب آمن</li><li class="inline-flex items-center gap-2 px-3 py-1.5 font-label font-bold text-xs bk-caps" style="background-color: var(--bk-surface-alt, #f7f4ee); color: var(--bk-ink, #1a1a1a); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-pill, 9999px);"><span class="material-symbols-outlined text-base" aria-hidden="true">storefront</span>بائع موثّق</li></ul><p class="font-body text-sm text-bk-ink-soft inline-flex items-center gap-2" data-i18n-field="reassurance_text_i18n"><span class="material-symbols-outlined text-xl text-bk-primary" aria-hidden="true">visibility</span>فحص مجاني عند الاستلام — لا تدفع إلا إذا أعجبتك القطعة.</p><button class="inline-flex items-center justify-center gap-2 font-display font-black bk-caps tracking-tight hover:translate-y-[1px] hover:translate-x-[1px] hover:shadow-none active:translate-y-[2px] active:translate-x-[2px] transition-[transform,box-shadow,background-color,color,opacity] duration-bk-fast motion-reduce:transition-none bg-bk-primary text-bk-on-primary px-6 py-4 text-lg w-full" style="background-color: var(--bk-primary, #ff5a8a); color: var(--bk-on-primary, #fff); border: var(--bk-border-thickness, 3px) solid var(--bk-ink, #1a1a1a); border-radius: var(--bk-radius-input, 0.75rem); box-shadow: var(--bk-shadow-button, 2px 2px 0px 0px #1a1a1a); font-family: var(--bk-font-display, inherit);" type="submit">أكّد الطلب — <bdi class="tabular-nums">128,500 د.ع</bdi><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></button><p class="text-center font-body text-xs text-bk-ink-soft">بتأكيدك الطلب، توافق على الدفع نقداً عند الاستلام. لا رسوم خفية.</p><div class="my-bk-2xs flex items-center gap-bk-sm"><span aria-hidden="true" class="flex-1" style="height: var(--bk-border-thickness, 3px); background-color: var(--bk-divider, rgb(26 26 26 / 0.15));"></span><span class="font-display font-black text-sm bk-caps text-bk-ink-soft">أو</span><span aria-hidden="true" class="flex-1" style="height: var(--bk-border-thickness, 3px); background-color: var(--bk-divider, rgb(26 26 26 / 0.15));"></span></div><a href="https://wa.me/9647779703832?text=%D9%87%D9%84%D8%A7%D8%8C%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A3%D9%83%D9%85%D9%84%20%D8%B7%D9%84%D8%A8%D9%8A%3A%0A%E2%80%A2%20%D8%B9%D8%B7%D8%B1%20%D9%88%D9%8A%D9%81%D8%B1%20%D8%A7%D9%86%D8%AA%D9%86%D8%B3%20%D8%A7%D9%84%D9%81%D8%A7%D8%AE%D8%B1%20%D9%85%D9%86%20%D8%A8%D8%A7%D8%B1%D9%8A%D8%B3%20%D9%83%D9%88%D8%B1%D9%86%D8%B1%20%D9%84%D9%84%D8%B1%D8%AC%D8%A7%D9%84%20%C3%97%202%0A%E2%80%A2%20%D9%86%D9%88%D8%B1%D8%AB%20%D8%B3%D8%AA%D8%A7%D9%83%202%20%C3%97%201%0A%D8%A7%D9%84%D9%85%D8%AC%D9%85%D9%88%D8%B9%3A%20128%2C500%