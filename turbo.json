{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_CATEGORIES_V2",
        "NEXT_PUBLIC_DEV_ROOT_DOMAIN",
        "NEXT_PUBLIC_PLATFORM_ORIGIN",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STOREFRONT_ORIGIN",
        "NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN",
        "NEXT_PUBLIC_STOREFRONT_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPPORT_WHATSAPP",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "SENTRY_AUTH_TOKEN",
        "STOREFRONT_ORDER_WEBHOOK_URL",
        "STOREFRONT_WA_CONFIRM_TENANT_IDS",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": false
    },
    "bundle-budget": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "generate-types": {
      "cache": false
    }
  }
}
